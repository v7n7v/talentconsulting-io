      "index": "noindex",
      "canonical": "omitted",
      "sitemap": "forbidden"
    },
    {
      "path": "/settings",
      "expectedStatus": [200],
      "bodyClass": "safe-shell",
      "crawl": "either",
      "index": "noindex",
      "canonical": "omitted",
      "sitemap": "forbidden"
    },
    {
      "path": "/auth/reset-password",
      "expectedStatus": [200],
