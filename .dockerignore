# Default deny. Build only a context prepared and verified by
# scripts/docker-build-context.js; gitignore is not a Docker boundary.
**
!.dockerignore
!Dockerfile
!package.json
!package-lock.json
!next.config.js
!postcss.config.js
!tailwind.config.ts
!tsconfig.json
!proxy.ts
!eslint.config.cjs
!app
!app/**
!components
!components/**
!hooks
!hooks/**
!lib
!lib/**
!emails
!emails/**
!public
!public/**
!types
!types/**
!scripts
scripts/**
!scripts/docker-build-context.js
!scripts/toolchain
scripts/toolchain/**
!scripts/toolchain/npm-distribution.cjs
!scripts/toolchain/npm-distribution.test.cjs
!scripts/toolchain/npm-runtime.cjs
!scripts/toolchain/npm-runtime.test.cjs
!toolchain
toolchain/**
!toolchain/npm
toolchain/npm/**
!toolchain/npm/distribution-profile.json
!toolchain/npm/toolchain-inputs.lock.json
!toolchain/npm/taco-npm-12.1.0-registry-patches.20261009.r1.tgz
!toolchain/npm/NOTICE.md
!.docker-install
!.docker-install/**
!.docker-build-context-manifest.json

# These deny rules also cover nested files and backup variants. The tracked
# public .env.production is deliberately absent; use the existing public ARGs.
**/.env*
**/env.*
**/.envrc*
**/.npmrc
**/hermes-agent-keys.txt
**/YOUR_CREDENTIALS.txt
**/*serviceAccount*
**/*service-account*
**/*service_account*
**/*credential*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/.aws
**/.aws/**
**/.ssh
**/.ssh/**
**/.config/gcloud
**/.config/gcloud/**
**/credentials
**/credentials/**
**/secrets
**/secrets/**
**/node_modules
**/node_modules/**
**/.git
**/.git/**
**/.next
**/.next/**
**/_backup
**/_backup/**
**/*.bak*
**/*.orig
**/*.save
**/*~
