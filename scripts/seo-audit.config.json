      "crawl": "either",
      "index": "noindex",
      "canonical": "omitted",
      "sitemap": "forbidden"
    },
    {
      "path": "/does-not-exist-seo-audit",
      "expectedStatus": [404],
      "bodyClass": "not-found",
      "crawl": "either",
      "index": "noindex",
      "canonical": "ignore",
