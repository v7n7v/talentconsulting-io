# Firebase / app runtime
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"..."}
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
# Enrollment UI only; existing MFA challenges remain supported when false.
NEXT_PUBLIC_MFA_ENABLED=false
FIREBASE_MFA_PROJECT_ENABLED=false
ADMIN_MFA_ENFORCED=false
NEXT_PUBLIC_ADMIN_COMMAND_GRID_V2=false
ADMIN_MUTATIONS_V2_ENABLED=false
ADMIN_RECOVERY_OWNERS_VERIFIED=false
ADMIN_REFERENCE_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local demo mode
# Set to true only when you want seeded demo data and the local auth bypass.
NEXT_PUBLIC_DISABLE_AUTH_GATE=false

# AI providers
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_AI_API_KEY=your_optional_google_ai_api_key
GROQ_API_KEY=your_groq_api_key

# Email and cron
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret
CRON_SECRET=replace_with_a_long_random_secret
UNSUBSCRIBE_SECRET=replace_with_a_long_random_secret

# Job recommendations
# Ever Jobs and direct public ATS boards supply jobs. Adzuna needs an explicit license.
EVER_JOBS_ENABLED=false
EVER_JOBS_API_URL=http://localhost:3001
EVER_JOBS_API_KEY=
EVER_JOBS_SAFE_SOURCES=greenhouse,lever,ashby,workday,remoteok,jobicy,himalayas,weworkremotely,usajobs
# Permit plain HTTP only to a single-label private Docker service name.
EVER_JOBS_ALLOW_PRIVATE_HTTP=false
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
ADZUNA_LICENSED=false

# Billing / optional production services
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Legacy Supabase variables, only needed for old local flows.
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Note: Never commit .env.local, .env, or copied key files to version control.
# Shared job catalog: server-only collection/read. Off until a provider is configured.
JOB_CATALOG_ENABLED=false
JOB_CATALOG_ORIGINS=greenhouse,lever,ashby,workday
JOB_INGEST_MAX_ITEMS=100
JOB_INGEST_MAX_REQUESTS=4
JOB_INGEST_DAILY_MAX_REQUESTS=100
JOB_INGEST_DAILY_MAX_RECORDS=1000
JOB_INGEST_INTERVAL_SECONDS=3600
JOB_INGEST_QUERY=software engineer
JOB_INGEST_LOCATION=United States
FANTASTIC_JOBS_ENABLED=false
FANTASTIC_JOBS_API_KEY=
FANTASTIC_JOBS_SOURCES=greenhouse,lever.co,ashby,workday
BRIGHT_DATA_JOBS_ENABLED=false
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_JOBS_DATASET_ID=
BRIGHT_DATA_JOBS_INPUT_JSON=[]
APIFY_JOBS_ENABLED=false
APIFY_API_TOKEN=
APIFY_JOBS_MAX_COST_USD=1
