{
  "siteUrl": "https://talentconsulting.io",
  "thinContentWordThreshold": 250,
  "minInternalLinks": 3,
  "minInboundLinksForPriorityPages": 2,
  "routePolicies": [
    {
      "path": "/privacy",
      "expectedStatus": [200],
      "bodyClass": "public-content",
      "crawl": "allowed",
      "index": "index",
      "canonical": "self",
      "sitemap": "optional"
    },
    {
      "path": "/terms",
      "expectedStatus": [200],
      "bodyClass": "public-content",
      "crawl": "allowed",
      "index": "index",
      "canonical": "self",
      "sitemap": "optional"
    },
    {
      "path": "/suite",
      "expectedStatus": [200],
      "bodyClass": "safe-shell",
      "crawl": "either",
      "index": "noindex",
      "canonical": "omitted",
      "sitemap": "forbidden"
    },
    {
      "path": "/suite/resume",
      "expectedStatus": [200],
      "bodyClass": "safe-shell",
      "crawl": "either",
      "index": "noindex",
      "canonical": "omitted",
      "sitemap": "forbidden"
    },
    {
